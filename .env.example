# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development

# Runtime connection: non-owner role, row-level security enforced.
DATABASE_URL=postgres://app_user:app_user_dev@localhost:54320/ai_insure
# Migration connection: table owner. Used only by `npm run db:migrate`.
DATABASE_OWNER_URL=postgres://app_owner:app_owner_dev@localhost:54320/ai_insure

REDIS_URL=redis://localhost:63790

API_PORT=3100
WEB_ORIGIN=http://localhost:4200

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars
BETTER_AUTH_URL=http://localhost:4200

# Optional: Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_HOST=localhost
SMTP_PORT=1125
MAIL_FROM="AI Insure <no-reply@ai-insure.local>"
