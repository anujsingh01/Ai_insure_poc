{
  "name": "@ai-insure/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=../../.env --watch-path=dist dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ai-insure/shared": "*",
    "bullmq": "^6.7.2",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.4.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "pino-pretty": "^13.2.0"
  }
}
